<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- implementationMode 用 compatible(TextureView)：叠加的检测框显示最稳定，坐标变换也最可控 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <com.example.taitoulv.HeadUpOverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部统计面板（左上角） -->
    <LinearLayout
        android:id="@+id/statsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/rateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#34C759"
            android:textSize="36sp"
            android:textStyle="bold"
            tools:text="抬头率 82.4%" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            tools:text="可见 17　抬头 14　低头 2　趴桌 1　闭眼 3" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            tools:text="即时 85%　最小脸 62px　事件 3" />

        <TextView
            android:id="@+id/recordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            tools:text="记录中：明细 12 行 / 事件 2 个 · 12.0fps" />
    </LinearLayout>

    <!-- 底部控制面板：整体可滚动，任何屏幕高度/小窗模式下都不会被裁掉；点屏幕可整体隐藏 -->
    <ScrollView
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/panel_bg"
        android:padding="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 摄像头按钮：独占整行、等分宽度，不会被方向按钮挤到截断 -->
            <LinearLayout
                android:id="@+id/cameraRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <!-- 变焦档位：0.6× 这种小于 1× 的档位就是超广角（厂商常把它藏在逻辑相机里） -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/zoomPresetRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/zoomText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                tools:text="变焦 1.0×　可用 0.6×–10.0×" />

            <SeekBar
                android:id="@+id/zoomSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:minHeight="56dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:progress="0"
                android:progressDrawable="@drawable/seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_thumb" />

            <SeekBar
                android:id="@+id/thresholdSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:minHeight="56dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:progress="30"
                android:progressDrawable="@drawable/seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_thumb" />

            <TextView
                android:id="@+id/thresholdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                tools:text="低于 -10° 记为低头（拖动上面滑块可调）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recordButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/record_start"
                    android:textSize="15sp"
                    tools:ignore="SmallSp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/orientationButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/orientation_auto"
                    android:textSize="15sp"
                    tools:ignore="SmallSp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recordsButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/records_button"
                    android:textSize="15sp"
                    tools:ignore="SmallSp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 控件隐藏后短暂提示一下怎么再唤出来 -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/panel_bg"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:text="@string/hint_hidden"
        android:textColor="#E6FFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        tools:ignore="SmallSp" />

    <!-- 未授权时的提示 -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/need_camera_permission"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantPermissionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grant_permission" />
    </LinearLayout>

</FrameLayout>
