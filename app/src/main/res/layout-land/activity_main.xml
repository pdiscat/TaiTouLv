<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏布局（配合沉浸式全屏：状态栏/导航栏都隐藏）
  - 右侧：加粗的变焦 / 低头阈值滑块 + 方向按钮
  - 底部：摄像头 + 变焦档位按钮条，整行等分宽度，一屏显示完，不需要滑动
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <com.example.taitoulv.HeadUpOverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 左上角统计 -->
    <LinearLayout
        android:id="@+id/statsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/rateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#34C759"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="抬头率 82.4%" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            tools:text="可见 17　抬头 14　低头 2　趴桌 1　闭眼 3" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            tools:text="即时 85%　最小脸 62px　事件 3" />

        <TextView
            android:id="@+id/recordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            tools:text="记录中：明细 12 行 / 事件 2 个 · 12.0fps" />
    </LinearLayout>

    <!-- 右侧：滑块（加粗、把手加大）；点屏幕可连同底部按钮条一起隐藏 -->
    <ScrollView
        android:id="@+id/controlPanel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="8dp"
        android:background="@drawable/panel_bg"
        android:padding="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/zoomText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                tools:text="变焦 1.0×　可用 0.6×–10.0×" />

            <SeekBar
                android:id="@+id/zoomSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:minHeight="60dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:progress="0"
                android:progressDrawable="@drawable/seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_thumb" />

            <SeekBar
                android:id="@+id/thresholdSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:minHeight="60dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:progress="30"
                android:progressDrawable="@drawable/seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_thumb" />

            <TextView
                android:id="@+id/thresholdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                tools:text="低于 -10° 记为低头" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/record_start"
                android:textSize="15sp"
                tools:ignore="SmallSp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/orientationButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/orientation_auto"
                    android:textSize="15sp"
                    tools:ignore="SmallSp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recordsButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/records_button"
                    android:textSize="15sp"
                    tools:ignore="SmallSp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部按钮条：两行等分整行宽度，一屏显示完，不滑动 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="290dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/cameraRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/zoomPresetRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 控件隐藏后短暂提示一下怎么再唤出来 -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:text="@string/hint_hidden"
        android:textColor="#E6FFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        tools:ignore="SmallSp" />

    <!-- 未授权时的提示 -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/need_camera_permission"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantPermissionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grant_permission" />
    </LinearLayout>

</FrameLayout>
